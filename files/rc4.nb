Cell["\<\
Let\[CloseCurlyQuote]s see the result when X and Y both follow Normal \
Distribution (just for fun)\
\>", "Text",
 CellChangeTimes->{{3.9197707526152167`*^9, 3.91977080512776*^9}, {
  3.919771041115024*^9, 
  3.9197710536912975`*^9}},ExpressionUUID->"d1f88fe2-6254-43a3-8ce1-\
853fc7bc28ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "random", " ", "variables"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"X", "=", 
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Y", "=", 
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "1"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Z", "=", 
     RowBox[{"TransformedDistribution", "[", 
      RowBox[{
       RowBox[{"x", "+", "y"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "\[Distributed]", "X"}], ",", 
         RowBox[{"y", "\[Distributed]", "Y"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "the", " ", "distribution", " ", "of", " ", "Z"}],
     "*)"}], "\n", "Z", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"V", "=", 
     RowBox[{"TransformedDistribution", "[", 
      RowBox[{
       RowBox[{"x", "*", "y"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "\[Distributed]", "X"}], ",", 
         RowBox[{"y", "\[Distributed]", "Y"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "V", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"W", "=", 
     RowBox[{"TransformedDistribution", "[", 
      RowBox[{
       RowBox[{"y", "/", "x"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "\[Distributed]", "X"}], ",", 
         RowBox[{"y", "\[Distributed]", "Y"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "W"}]}]], "Input",
 CellChangeTimes->{{3.9197708234964757`*^9, 3.919770870430727*^9}, 
   3.919775835999627*^9, {3.9198128559346523`*^9, 
   3.9198128820417986`*^9}},ExpressionUUID->"eac15c99-6e2d-4d7f-a58e-\
17233995a90c"],

Cell[BoxData[
 RowBox[{"NormalDistribution", "[", 
  RowBox[{"0", ",", 
   SqrtBox["2"]}], "]"}]], "Output",
 CellChangeTimes->{3.919770875272544*^9, 3.919775838956174*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"af513985-a40b-4150-b9d3-c00be9d119c3"],

