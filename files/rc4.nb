             RowBox[{"-", "r"}], "+", "R"}], ",", 
            RowBox[{"n", "-", "x"}]}], "]"}]}], 
         RowBox[{"Binomial", "[", 
          RowBox[{"R", ",", "n"}], "]"}]], 
        RowBox[{
         RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "n"}], "&&", 
