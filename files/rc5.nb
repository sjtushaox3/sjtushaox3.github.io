 CellLabel->"Out[16]=",ExpressionUUID->"d0dbbc10-ca52-4bf8-9c9e-ecd1d2087d99"]
}, Open  ]],

Cell["n = 3 is sufficient.\n", "Text",
 CellChangeTimes->{
