Notebook[{
Cell["\<\
The diameters of bolts are known to have a standard deviation of 0.0001 inch. \
A random sample of 10 bolts
yields an average diameter of 0.2546 inch.
i) Test the hypothesis that the true mean diameter of bolts equals 0.255 \
inch, using \[Alpha] = 0.05.
ii)What size sample would be necessary to detect a true mean bolt diameter of \
0.2552 inch or more with a
probability of at least 0.90, assuming \[Alpha] = 0.05?
\
\>", "Text",
 CellChangeTimes->{
  3.92156931350072*^9, {3.921571343402564*^9, 
   3.921571356480052*^9}},ExpressionUUID->"b6417b77-dcf9-48c0-89a0-\
79284e33baec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H0", ":", "\[Micro]"}], "=", 
  RowBox[{
   RowBox[{"0.255", " ", "at", " ", "\[Alpha]"}], "=", 
   RowBox[{
    RowBox[{"0.05", ".", "Z"}], "=", 
    FractionBox[
     RowBox[{
      OverscriptBox["X", "_"], "-", "0.255"}], 
     RowBox[{"\[Sigma]", "/", 
      SqrtBox["n"]}]]}]}]}]], "Text",
 CellChangeTimes->{{3.921569160042094*^9, 3.921569184856391*^9}, {
   3.921569220011057*^9, 3.921569248622424*^9}, 3.9215692816659985`*^9, {
   3.9215695031030083`*^9, 
   3.921569524603361*^9}},ExpressionUUID->"7dd7a070-2395-49ae-bac5-\
060062bd71e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Z", "=", 
  FractionBox[
   RowBox[{"0.2546", "-", "0.255"}], 
   RowBox[{"0.0001", "/", 
    SqrtBox["10"]}]]}]], "Input",
 CellChangeTimes->{{3.921569270316224*^9, 3.921569275745637*^9}, {
  3.9215693233351603`*^9, 3.9215693347033305`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"6b5418c0-9181-44dc-9b13-ff45da52c19d"],

Cell[BoxData[
 RowBox[{"-", "12.649110640673879`"}]], "Output",
 CellChangeTimes->{3.92156934154045*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"f82f67a2-299c-4b2c-a1d1-128b33b0ad16"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"InverseCDF", "[", 
  RowBox[{
   RowBox[{"NormalDistribution", "[", "]"}], ",", 
   RowBox[{"1", "-", 
    FractionBox["0.05", "2"]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"InverseCDF", "[", 
  RowBox[{
   RowBox[{"NormalDistribution", "[", "]"}], ",", 
   FractionBox["0.05", "2"]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9215693853138914`*^9, 3.921569436635418*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"dcbe324e-987a-4a77-a643-6c8edc110fe3"],

Cell[BoxData["1.9599639845400538`"], "Output",
 CellChangeTimes->{{3.9215694192464857`*^9, 3.9215694397809353`*^9}},
 CellLabel->"Out[4]=",ExpressionUUID->"4e286fba-9d32-4f73-8d3c-ceb2ed047622"],

Cell[BoxData[
 RowBox[{"-", "1.9599639845400545`"}]], "Output",
 CellChangeTimes->{{3.9215694192464857`*^9, 3.921569439784412*^9}},
 CellLabel->"Out[5]=",ExpressionUUID->"9a65d3bc-42ee-4e72-8aad-7170b4f62f61"]
}, Open  ]],

Cell[" we reject H0", "Text",
 CellChangeTimes->{
  3.921569490563734*^9, {3.921569756370161*^9, 
   3.921569760987343*^9}},ExpressionUUID->"43539499-7374-4bbf-96f0-\
362a12834e3e"],

Cell[BoxData[
 RowBox[{"d", "=", 
  FractionBox[
   RowBox[{"\[Mu]", "-", 
    SubscriptBox["\[Mu]", "0"]}], "\[Sigma]"]}]], "Text",
 CellChangeTimes->{{3.9215713693837695`*^9, 
  3.9215714195848684`*^9}},ExpressionUUID->"f6b89e56-f051-448d-b6ee-\
5195966e6318"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"d", "=", 
  FractionBox[
   RowBox[{"0.2552", "-", "0.255"}], "0.0001"]}]], "Input",
 CellChangeTimes->{{3.921571422927801*^9, 3.9215714398973513`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"e6d4417f-2775-4b7e-b33e-9dded36a6bcf"],

